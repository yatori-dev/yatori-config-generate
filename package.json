{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron": "npm run build && npm run build:electron && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "antd": "^5.25.3",
    "file-saver": "^2.0.5",
    "js-yaml": "^4.1.0",
    "vue": "^3.5.15"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/file-saver": "^2.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.5.15",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^3.0.7"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.yatori.app",
    "productName": "Yatori",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "win":{
      "target": "nsis",
      "icon": "public/icon.ico"
    },
     "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
